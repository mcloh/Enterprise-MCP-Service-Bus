# Copy to .env and fill in real values for local development.
# Never commit a real .env -- see docs/RI-PLANNING.md, EP-00-T05 (gestão de segredos).

# --- Gateway (EP-05) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- Example Sales-domain MCP server (EP-06-T02) ---
SALES_DOMAIN_HOST=0.0.0.0
SALES_DOMAIN_PORT=8100
# How the Gateway reaches it (service name resolves inside docker compose;
# use 127.0.0.1 for `make dev`, which runs both processes on the host).
SALES_DOMAIN_URL=http://sales-domain:8100/mcp

# --- Observability (EP-08) ---
# Unset (default): traces print to stdout via ConsoleSpanExporter.
# Set to enable OTLP/HTTP export instead (requires the `emcp-bus[otlp]` extra
# and a running collector -- see EP-08-T04).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
